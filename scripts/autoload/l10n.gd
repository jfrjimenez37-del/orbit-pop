var lang := "en"
var _idx := 0


func _ready() -> void:
	set_lang(Save.lang if Save.lang != "" else detect())


static func detect() -> String:
	var loc := OS.get_locale()
	if loc.begins_with("es"):
		return "es"
	if loc.begins_with("pt"):
		return "pt_BR" if loc.ends_with("BR") or loc == "pt" else "pt"
	return "en"


func set_lang(code: String) -> void:
	lang = code if LANGS.has(code) else "en"
	_idx = LANGS.find(lang)
	TranslationServer.set_locale(lang)
	changed.emit()


## Translates a key; unknown keys are returned unchanged (handy for names).
func t(key: String, args = null) -> String:
	if not T.has(key):
		return key
	var s: String = T[key][_idx]
	if args == null:
		return s
	return s % args
