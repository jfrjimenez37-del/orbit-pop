	"EUROPE": ["ES", "PT", "FR", "DE", "IT", "GB", "IE", "NL", "BE", "LU", "CH", "AT", "PL", "CZ", "SK", "HU", "RO", "BG", "GR", "SE", "NO", "DK", "FI", "IS", "EE", "LV", "LT", "SI", "HR", "RS", "UA", "AD"],
	"NORTH_AMERICA": ["US", "CA"],
