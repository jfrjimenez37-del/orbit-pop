class_name PlayGamesConfig
## IDs generated by Google Play Console (Play Games Services). Leave "" until created:
## empty ids are skipped, so the game works fine before setup.

const LEADERBOARDS := {
	"GLOBAL": "",
	"LATAM": "",
	"BRASIL": "",
	"EUROPE": "",
	"NORTH_AMERICA": "",
	"ASIA_PACIFIC": "",
	"AFRICA_ME": "",
}

const ACHIEVEMENTS := {
	"first": "", "score10": "", "score25": "", "score50": "", "score100": "", "score150": "",
	"world2": "", "world3": "", "world4": "", "world5": "", "near50": "", "bubbles100": "",
	"games50": "", "missions7": "", "switch10": "", "warp": "",
}

const CLOUD_SLOT := "orbitpop_progress"

## Regional board from the device locale country (no servers, no location permission).
const REGIONS := {
	"LATAM": ["MX", "AR", "CO", "CL", "PE", "VE", "EC", "GT", "CU", "BO", "DO", "HN", "PY", "SV", "NI", "CR", "PA", "UY", "PR"],
	"BRASIL": ["BR"],
	"EUROPE": ["ES", "PT", "FR", "DE", "IT", "GB", "IE", "NL", "BE", "LU", "CH", "AT", "PL", "CZ", "SK", "HU", "RO", "BG", "GR", "SE", "NO", "DK", "FI", "IS", "EE", "LV", "LT", "SI", "HR", "RS", "UA", "AD"],
	"NORTH_AMERICA": ["US", "CA"],
	"ASIA_PACIFIC": ["JP", "KR", "CN", "TW", "HK", "IN", "ID", "PH", "TH", "VN", "MY", "SG", "AU", "NZ", "PK", "BD"],
}
const REGION_NAMES := {"LATAM": "LATAM", "BRASIL": "BRASIL", "EUROPE": "EUROPA", "NORTH_AMERICA": "N. AMERICA",
	"ASIA_PACIFIC": "ASIA-PACIFIC", "AFRICA_ME": "AFRICA / M.E."}


static func region(locale := "") -> String:
	var loc := OS.get_locale() if locale == "" else locale
	var parts := loc.split("_")
	if parts.size() >= 2:
		var cc := parts[1].substr(0, 2).to_upper()
		for r in REGIONS:
			if REGIONS[r].has(cc):
				return r
		return "AFRICA_ME"
	# no country in the locale: guess from the language
	if loc.begins_with("pt"):
		return "BRASIL"
	if loc.begins_with("es"):
		return "LATAM"
	return "NORTH_AMERICA" if loc.begins_with("en") else "EUROPE"
