	"ASIA_PACIFIC": "ASIA-PACIFIC", "AFRICA_ME": "AFRICA / M.E."}


static func region(locale := "") -> String:
	var loc := OS.get_locale() if locale == "" else locale
	var parts := loc.split("_")
	if parts.size() >= 2:
		var cc := parts[1].substr(0, 2).to_upper()
		for r in REGIONS:
			if REGIONS[r].has(cc):
				return r
		return "AFRICA_ME"
	# no country in the locale: guess from the language
	if loc.begins_with("pt") or loc.begins_with("es"):
		return "SOUTH_AMERICA"
	return "NORTH_AMERICA" if loc.begins_with("en") else "EUROPE"
